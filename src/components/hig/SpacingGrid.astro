---
const spaces = [
  { token: 'mauna.space.xs', val: '4px' },
  { token: 'mauna.space.sm', val: '8px' },
  { token: 'mauna.space.md', val: '12px' },
  { token: 'mauna.space.lg', val: '16px' },
  { token: 'mauna.space.xl', val: '24px' },
  { token: 'mauna.space.2xl', val: '32px' },
  { token: 'mauna.space.3xl', val: '48px' },
];

const radii = [
  { token: 'mauna.radius.sm', val: '4px', role: 'мелкие элементы: чипы, точки, теги' },
  { token: 'mauna.radius.lg', val: '8px', role: 'карточки, попапы, диалоги' },
];
---

<div class="spacing-container">
  <div class="spaces-card">
    <h4 class="block-title">Шкала отступов (8-точечная сетка)</h4>
    <div class="spaces-list">
      {spaces.map(s => (
        <div class="space-row">
          <div class="space-meta">
            <code>{s.token}</code>
            <span class="space-val">{s.val}</span>
          </div>
          <div class="space-bar-wrapper">
            <div class="space-bar" style={`width: ${s.val};`}></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="radii-card">
    <h4 class="block-title">Скругления</h4>
    <div class="radii-grid">
      {radii.map(r => (
        <div class="radius-item">
          <div class="radius-box" style={`border-radius: ${r.val};`}>
            <code>{r.val}</code>
          </div>
          <div class="radius-meta">
            <code>{r.token}</code>
            <span class="radius-role">{r.role}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .spacing-container {
    display: flex;
    flex-direction: column;
    gap: var(--mauna-space-lg);
    margin: var(--mauna-space-lg) 0;
  }

  .spaces-card, .radii-card {
    border: var(--mauna-border);
    border-radius: var(--mauna-radius-lg);
    background-color: var(--mauna-bg-chrome);
    padding: var(--mauna-space-md);
  }

  .block-title {
    font-size: var(--mauna-type-ui-size);
    font-weight: 500;
    margin-bottom: var(--mauna-space-md);
    color: var(--mauna-text-primary);
  }

  .spaces-list {
    display: flex;
    flex-direction: column;
    gap: var(--mauna-space-xs);
  }

  .space-row {
    display: flex;
    align-items: center;
    gap: var(--mauna-space-md);
  }

  .space-meta {
    flex: 0 0 200px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .space-val {
    font-family: var(--mauna-font-doc);
    font-size: 12px;
    color: var(--mauna-text-secondary);
  }

  .space-bar-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .space-bar {
    height: 12px;
    background-color: var(--mauna-accent);
    border-radius: 2px;
  }

  .radii-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--mauna-space-md);
  }

  .radius-item {
    display: flex;
    flex-direction: column;
    gap: var(--mauna-space-sm);
  }

  .radius-box {
    height: 64px;
    background-color: var(--mauna-bg-canvas);
    border: var(--mauna-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .radius-box code {
    font-size: 12px;
  }

  .radius-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .radius-role {
    font-size: 12px;
    color: var(--mauna-text-secondary);
  }
</style>
