---
interface Props {
  token: string;
  hexLight: string;
  hexDark?: string;
  role: string;
}

const { token, hexLight, hexDark, role } = Astro.props;
---

<div class="swatch-card">
  <div class="swatches-row">
    <div class="swatch-box" style={`background-color: ${hexLight};`}>
      <span class="swatch-mode-label">Светлая</span>
    </div>
    {hexDark && (
      <div class="swatch-box dark" style={`background-color: ${hexDark};`}>
        <span class="swatch-mode-label">Тёмная</span>
      </div>
    )}
  </div>
  <div class="swatch-meta">
    <div class="token-row">
      <code class="token-name">{token}</code>
      <span class="hex-values">
        <span>{hexLight}</span>
        {hexDark && hexDark !== hexLight && <span class="hex-dark">/ {hexDark}</span>}
      </span>
    </div>
    <div class="token-role">{role}</div>
  </div>
</div>

<style>
  .swatch-card {
    border: var(--mauna-border);
    border-radius: var(--mauna-radius-lg);
    background-color: var(--mauna-bg-chrome);
    padding: var(--mauna-space-sm);
    display: flex;
    flex-direction: column;
    gap: var(--mauna-space-sm);
  }

  .swatches-row {
    display: flex;
    gap: var(--mauna-space-xs);
    height: 56px;
  }

  .swatch-box {
    flex: 1;
    border-radius: var(--mauna-radius-sm);
    border: var(--mauna-border);
    display: flex;
    align-items: flex-end;
    padding: var(--mauna-space-xs);
  }

  .swatch-mode-label {
    font-size: 10px;
    font-family: var(--mauna-font-ui);
    color: var(--mauna-text-secondary);
    background: rgba(0, 0, 0, 0.05);
    padding: 1px 4px;
    border-radius: 2px;
  }

  [data-theme="dark"] .swatch-mode-label {
    background: rgba(255, 255, 255, 0.1);
  }

  .swatch-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 var(--mauna-space-xs);
  }

  .token-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--mauna-space-sm);
  }

  .token-name {
    font-family: var(--mauna-font-doc);
    font-size: 13px;
    font-weight: 700;
  }

  .hex-values {
    font-family: var(--mauna-font-doc);
    font-size: 12px;
    color: var(--mauna-text-secondary);
  }

  .token-role {
    font-size: 12px;
    color: var(--mauna-text-secondary);
    line-height: 1.3;
  }
</style>
