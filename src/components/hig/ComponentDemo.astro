---

---

<div class="component-sandbox">
    <div class="app-frame" id="demo-app-frame">
        <header class="app-toolbar" id="demo-toolbar">
            <div class="toolbar-group">
                <button
                    type="button"
                    class="icon-btn"
                    id="demo-btn-new"
                    title="Новый документ"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <path
                            d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                        ></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                </button>
                <button
                    type="button"
                    class="icon-btn"
                    id="demo-btn-save"
                    title="Сохранить"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <path
                            d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"
                        ></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>
                    </svg>
                </button>
                <button
                    type="button"
                    class="icon-btn"
                    id="demo-toggle-palette"
                    title="Командная палитра"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
            </div>

            <div class="toolbar-group">
                <button
                    type="button"
                    class="icon-btn"
                    id="demo-toggle-focus"
                    title="Фокус-режим"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <path
                            d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
                        ></path>
                    </svg>
                </button>
                <button
                    type="button"
                    class="icon-btn action-icon-btn"
                    id="demo-btn-export"
                    title="Экспорт"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                        ></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                </button>
            </div>
        </header>

        <button
            type="button"
            class="restore-toolbar-btn"
            id="demo-restore-toolbar"
            title="Вернуть тулбар"
        >
            <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
            >
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </button>

        <div class="app-body">
            <aside class="app-sidebar" id="demo-sidebar">
                <div class="sidebar-item active">Глава 1: Введение</div>
                <div class="sidebar-item">Глава 2: Принципы</div>
                <div class="sidebar-item">Глава 3: Токены</div>
                <div class="sidebar-item">Глава 4: Вывод</div>
            </aside>

            <main class="app-canvas">
                <div class="document-sheet">
                    <p class="doc-text">
                        Писательский интерфейс без лишнего визуального шума.<span
                            class="doc-cursor"></span>
                    </p>
                </div>

                <div class="command-palette" id="demo-palette">
                    <div class="palette-input-wrapper">
                        <input
                            type="text"
                            placeholder="Введите команду..."
                            class="palette-input"
                        />
                    </div>
                    <div class="palette-list">
                        <div class="palette-item active">
                            Сменить акцентный цвет
                        </div>
                        <div class="palette-item">Экспорт в Markdown</div>
                        <div class="palette-item">Полноэкранный режим</div>
                    </div>
                </div>
            </main>
        </div>

        <footer class="app-statusbar">
            <span class="statusbar-item">Courier Prime 16px</span>
            <span class="statusbar-item">Стр. 1 / 18 слов</span>
        </footer>
    </div>
</div>

<script>
    const toggleFocusBtn = document.getElementById("demo-toggle-focus");
    const restoreBtn = document.getElementById("demo-restore-toolbar");
    const toolbar = document.getElementById("demo-toolbar");
    const togglePaletteBtn = document.getElementById("demo-toggle-palette");
    const palette = document.getElementById("demo-palette");

    toggleFocusBtn?.addEventListener("click", () => {
        toolbar?.classList.add("hidden-toolbar");
        restoreBtn?.classList.add("visible");
    });

    restoreBtn?.addEventListener("click", () => {
        toolbar?.classList.remove("hidden-toolbar");
        restoreBtn?.classList.remove("visible");
    });

    togglePaletteBtn?.addEventListener("click", () => {
        palette?.classList.toggle("visible");
    });

    const sidebarItems = document.querySelectorAll(
        ".app-sidebar .sidebar-item",
    );
    sidebarItems.forEach((item) => {
        item.addEventListener("click", () => {
            sidebarItems.forEach((i) => i.classList.remove("active"));
            item.classList.add("active");
        });
    });
</script>

<style>
    .component-sandbox {
        border: var(--mauna-border);
        border-radius: var(--mauna-radius-lg);
        background-color: var(--mauna-bg-chrome);
        margin: var(--mauna-space-lg) 0;
        overflow: hidden;
    }

    .app-frame {
        position: relative;
        background-color: var(--mauna-bg-canvas);
        min-height: 280px;
        display: flex;
        flex-direction: column;
    }

    .app-toolbar {
        height: var(--mauna-toolbar-height);
        background-color: var(--mauna-bg-chrome);
        border-bottom: var(--mauna-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 var(--mauna-space-md);
        transition:
            transform var(--mauna-motion-slow),
            height var(--mauna-motion-slow),
            opacity var(--mauna-motion-slow);
        z-index: 10;
    }

    .app-toolbar.hidden-toolbar {
        transform: translateY(-100%);
        height: 0;
        opacity: 0;
        overflow: hidden;
        padding: 0;
        border-bottom: none;
    }

    .restore-toolbar-btn {
        position: absolute;
        top: 4px;
        right: 4px;
        width: 24px;
        height: 24px;
        border: var(--mauna-border);
        border-radius: var(--mauna-radius-sm);
        background-color: var(--mauna-bg-chrome);
        color: var(--mauna-text-secondary);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 20;
        transition: color var(--mauna-motion-fast);
    }

    .restore-toolbar-btn:hover {
        color: var(--mauna-text-primary);
    }

    .restore-toolbar-btn.visible {
        display: flex;
    }

    .toolbar-group {
        display: flex;
        align-items: center;
        gap: var(--mauna-space-xs);
    }

    .icon-btn {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--mauna-radius-sm);
        color: var(--mauna-text-secondary);
        background: transparent;
        border: none;
        transition:
            color var(--mauna-motion-fast),
            background-color var(--mauna-motion-fast);
    }

    .icon-btn:hover {
        color: var(--mauna-text-primary);
        background-color: var(--mauna-bg-canvas);
    }

    .action-icon-btn {
        color: var(--mauna-accent);
    }

    .app-body {
        display: flex;
        flex: 1;
        min-height: 200px;
    }

    .app-sidebar {
        width: 170px;
        background-color: var(--mauna-bg-chrome);
        border-right: var(--mauna-border);
        padding: var(--mauna-space-sm) 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .sidebar-item {
        font-size: var(--mauna-type-ui-size);
        padding: var(--mauna-space-xs) var(--mauna-space-md);
        color: var(--mauna-text-secondary);
        cursor: pointer;
        transition: color var(--mauna-motion-fast);
    }

    .sidebar-item:hover {
        color: var(--mauna-text-primary);
    }

    .sidebar-item.active {
        background-color: var(--mauna-bg-canvas);
        color: var(--mauna-text-primary);
    }

    .app-canvas {
        flex: 1;
        position: relative;
        padding: var(--mauna-space-lg);
        display: flex;
        justify-content: center;
        background-color: var(--mauna-bg-canvas);
    }

    .document-sheet {
        max-width: 440px;
        width: 100%;
    }

    .doc-text {
        font-family: var(--mauna-font-doc);
        font-size: var(--mauna-type-doc-size);
        line-height: var(--mauna-type-doc-lh);
        color: var(--mauna-text-primary);
        margin: 0;
    }

    .doc-cursor {
        display: inline-block;
        width: 2px;
        height: 1.1em;
        background-color: var(--mauna-accent);
        vertical-align: text-bottom;
        margin-left: 2px;
        animation: cursorBlink 1060ms infinite steps(1, start);
    }

    @keyframes cursorBlink {
        0%,
        50% {
            opacity: 1;
        }
        50.01%,
        100% {
            opacity: 0;
        }
    }

    .command-palette {
        position: absolute;
        top: 20px;
        left: 50%;
        transform: translateX(-50%) translateY(-10px);
        width: 320px;
        background-color: var(--mauna-bg-chrome);
        border: var(--mauna-border);
        border-radius: var(--mauna-radius-lg);
        box-shadow: var(--mauna-shadow-popup);
        opacity: 0;
        pointer-events: none;
        transition:
            opacity var(--mauna-motion-base),
            transform var(--mauna-motion-base);
        z-index: 50;
    }

    .command-palette.visible {
        opacity: 1;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
    }

    .palette-input-wrapper {
        padding: var(--mauna-space-xs);
        border-bottom: var(--mauna-border);
    }

    .palette-input {
        width: 100%;
        background: transparent;
        border: none;
        font-size: var(--mauna-type-ui-size);
        color: var(--mauna-text-primary);
        outline: none;
        padding: var(--mauna-space-xs);
    }

    .palette-list {
        padding: var(--mauna-space-xs) 0;
    }

    .palette-item {
        padding: var(--mauna-space-xs) var(--mauna-space-md);
        font-size: 13px;
        color: var(--mauna-text-secondary);
        cursor: pointer;
    }

    .palette-item:hover,
    .palette-item.active {
        background-color: var(--mauna-bg-canvas);
        color: var(--mauna-text-primary);
    }

    .app-statusbar {
        height: var(--mauna-statusbar-height);
        background-color: var(--mauna-bg-chrome);
        border-top: var(--mauna-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 var(--mauna-space-md);
        font-size: var(--mauna-type-caption-size);
        color: var(--mauna-text-secondary);
    }
</style>
