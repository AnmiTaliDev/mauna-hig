---

---

<header class="mauna-toolbar">
    <div class="toolbar-left">
        <button
            type="button"
            class="sidebar-toggle-btn"
            id="mobile-sidebar-toggle"
            aria-label="Меню"
        >
            <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
            >
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
        <a href="/" class="brand-link">
            <span class="brand-name">Mauna</span>
            <span class="brand-sub">HIG</span>
        </a>
    </div>

    <div class="toolbar-right">
        <a
            href="/all"
            class="view-all-link"
            title="Полный документ на одной странице">Все разделы</a
        >
        <button
            type="button"
            class="settings-trigger-btn"
            id="settings-trigger-btn"
            title="Настройки оформления"
        >
            <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
            >
                <circle cx="12" cy="12" r="3"></circle>
                <path
                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
                ></path>
            </svg>
            <span>Настройки</span>
        </button>
    </div>
</header>

<script>
    const toggleBtn = document.getElementById("mobile-sidebar-toggle");
    const sidebar = document.querySelector(".mauna-sidebar");
    toggleBtn?.addEventListener("click", () => {
        sidebar?.classList.toggle("open");
    });

    const settingsTrigger = document.getElementById("settings-trigger-btn");
    settingsTrigger?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("mauna:open-settings"));
    });
</script>

<style>
    .mauna-toolbar {
        height: var(--mauna-toolbar-height);
        background-color: var(--mauna-bg-chrome);
        border-bottom: var(--mauna-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 var(--mauna-space-md);
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .toolbar-left,
    .toolbar-right {
        display: flex;
        align-items: center;
        gap: var(--mauna-space-md);
    }

    .sidebar-toggle-btn {
        display: none;
        align-items: center;
        justify-content: center;
        color: var(--mauna-text-primary);
    }

    @media (max-width: 860px) {
        .sidebar-toggle-btn {
            display: inline-flex;
        }
    }

    .brand-link {
        text-decoration: none;
        display: inline-flex;
        align-items: baseline;
        gap: 4px;
    }

    .brand-name {
        font-size: 15px;
        font-weight: 500;
        color: var(--mauna-text-primary);
        letter-spacing: -0.2px;
    }

    .brand-sub {
        font-size: 11px;
        color: var(--mauna-text-secondary);
        font-family: var(--mauna-font-doc);
    }

    .view-all-link {
        font-size: var(--mauna-type-caption-size);
        color: var(--mauna-text-secondary);
        text-decoration: none;
        transition: color var(--mauna-motion-fast);
    }

    .view-all-link:hover {
        color: var(--mauna-text-primary);
    }

    .settings-trigger-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: var(--mauna-type-caption-size);
        color: var(--mauna-text-secondary);
        padding: 4px 8px;
        border: var(--mauna-border);
        border-radius: var(--mauna-radius-sm);
        background-color: var(--mauna-bg-canvas);
        transition:
            color var(--mauna-motion-fast),
            border-color var(--mauna-motion-fast);
    }

    .settings-trigger-btn:hover {
        color: var(--mauna-text-primary);
        border-color: var(--mauna-accent);
    }
</style>
