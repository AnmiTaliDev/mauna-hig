---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { slug: 'about', title: 'Что такое Mauna' },
  { slug: 'principles', title: 'Принципы' },
  { slug: 'color', title: 'Цвет' },
  { slug: 'typography', title: 'Типографика' },
  { slug: 'spacing-and-grid', title: 'Пространство и сетка' },
  { slug: 'motion', title: 'Движение' },
  { slug: 'components', title: 'Компоненты' },
  { slug: 'theme-structure', title: 'Тема как открытая структура' },
  { slug: 'iconography', title: 'Иконография' },
  { slug: 'voice-and-tone', title: 'Голос и тон текста' },
  { slug: 'limitations', title: 'Ограничения системы' },
  { slug: 'license', title: 'Лицензия' },
];

const cleanPath = currentPath.replace(/^\/|\/$/g, '');
---

<aside class="mauna-sidebar">
  <div class="sidebar-header">
    <span class="sidebar-title">Разделы HIG</span>
  </div>
  <nav class="sidebar-nav">
    <ul class="nav-list">
      {navItems.map(item => {
        const isActive = cleanPath === item.slug || (cleanPath === '' && item.slug === 'about');
        return (
          <li class="nav-item">
            <a
              href={`/${item.slug}`}
              class:list={['nav-link', { active: isActive }]}
            >
              {item.title}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</aside>

<style>
  .mauna-sidebar {
    width: var(--mauna-sidebar-width);
    background-color: var(--mauna-bg-chrome);
    border-right: var(--mauna-border);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    overflow-y: auto;
  }

  @media (max-width: 860px) {
    .mauna-sidebar {
      position: fixed;
      top: var(--mauna-toolbar-height);
      left: 0;
      bottom: 0;
      z-index: 90;
      transform: translateX(-100%);
      transition: transform var(--mauna-motion-base);
    }

    .mauna-sidebar.open {
      transform: translateX(0);
    }
  }

  .sidebar-header {
    padding: var(--mauna-space-md) var(--mauna-space-md) var(--mauna-space-xs);
  }

  .sidebar-title {
    font-size: var(--mauna-type-caption-size);
    color: var(--mauna-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .sidebar-nav {
    padding: var(--mauna-space-xs) 0;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-link {
    display: block;
    padding: 6px var(--mauna-space-md);
    font-size: var(--mauna-type-ui-size);
    line-height: var(--mauna-type-ui-lh);
    color: var(--mauna-text-secondary);
    text-decoration: none;
    transition: color var(--mauna-motion-fast);
  }

  .nav-link:hover {
    color: var(--mauna-text-primary);
  }

  .nav-link.active {
    background-color: var(--mauna-bg-canvas);
    color: var(--mauna-text-primary);
    font-weight: 500;
  }
</style>
